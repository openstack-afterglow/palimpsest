# Palimpsest configuration generated by kolla-ansible

[keystone]
auth_url = "{{ palimpsest_keystone_auth_url }}"
username = "{{ palimpsest_keystone_user }}"
password = "{{ palimpsest_keystone_password }}"
project_name = "{{ palimpsest_service_project_name }}"
project_domain_name = "{{ palimpsest_keystone_project_domain_name }}"
user_domain_name = "{{ palimpsest_keystone_user_domain_name }}"
region = "{{ palimpsest_keystone_region_name }}"
interface = "{{ palimpsest_keystone_interface }}"
insecure = {{ openstack_insecure | default(false) | bool | lower }}
cacert = "{{ openstack_cacert | default('') }}"

[database]
url = "{{ palimpsest_database_url }}"
pool_size = 5
max_overflow = 10
connect_timeout = 10
pool_timeout = 10

[cache]
redis_url = "{{ palimpsest_redis_url }}"

[palimpsest]
hub_local_path = "{{ palimpsest_hub_path }}"

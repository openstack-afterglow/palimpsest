    {
      "id": "oci-bundle-v1",
      "status": "diverged-stricter-local",
      "analysis": "Both sides exchange OCI image-layout tar bundles. The standalone importer validates OCI layout and layer data more strictly; preserve that stricter boundary rather than weakening the local package to match an upstream import shortcut.",
      "upstream": [
        {
          "path": "backend/app/api/palimpsest/hub.py",
          "sha256": "51a31d6f5974743c823f825ac8b8fb9cabe4c332be6aabd37e0112b253ec5cc0",
          "must_contain": [
            "@router.post(\"/bundles/import\")",
            "iter_bundle_tar",
            "parse_bundle"
          ]
        },
        {
          "path": "backend/app/services/palimpsest_hub_bundle.py",
          "sha256": "684ac66a8977a2cd332ba61ad89629b593faec592c207f370c4214475e861573"
        }
      ],
      "counterparts": [
        {
          "path": "src/palimpsest_local/oci_layout.py",
          "sha256": "b648f1e49842b019f6db8b16327206dc7481a44b1874f6fb1554f4148ac3cb15",
          "must_contain": [
            "OCI_LAYOUT_VERSION",
            "def extract_bundle_tar",
            "def verify_layout_dir"
          ]
        }
      ]
    },
    {
      "id": "local-runtime-cutover",
      "status": "partial",
      "analysis": "The standalone package owns local build, runtime, KVM, and CLI mechanics. Afterglow still owns its API registration, configuration, build orchestration, and administration. Changes here need an explicit cutover decision, not a source copy.",
      "upstream": [
        {
          "path": "backend/app/api/palimpsest/builds.py",
          "sha256": "b29732e1b59621f33c642e0034a584ea6137e73c0a52ebb64e7456c583825462"

{
  "schema_version": 1,
  "scope": "Structural ownership and public-boundary tracking for standalone Palimpsest Hub and Afterglow's BFF consumer; not runtime, authentication, deployment, or native proof. Lumen and Waygate are out of scope.",
  "upstream": {
    "repository": "https://github.com/openstack-afterglow/openstack-afterglow.git",
    "ref": "main",
    "baseline_commit": "2862565c1f59eac0ef0904b97c905b177f12b335"
  },
  "absence_rules": [
    {
      "glob": "services/palimpsest*",
      "expected_matches": 0,
      "analysis": "The extracted Hub authority lives in this repository's hub/ package, not an embedded Afterglow services/palimpsest tree. Reintroducing that owner requires review."
    },
    {
      "glob": "backend/app/services/palimpsest_hub_bundle.py",
      "expected_matches": 0,
      "analysis": "Bundle parsing and export belong to the extracted Hub; Afterglow must not restore its removed embedded implementation."
    }
  ],
  "contracts": [
    {
      "id": "hub-http-v1",
      "status": "implemented",
      "analysis": "Palimpsest Hub owns native /v1 artifact routes and project/creator-bound upload sessions. Afterglow main is an authenticated BFF consumer forwarding caller-scoped Keystone identity and Upload-Offset, not the Hub implementation. HubClient retains authoritative GET upload status and exact offset resumption. Boundary markers require review when removed but do not prove authentication or HTTP behavior; existing Hub/client behavioral suites remain required.",
      "upstream": [
        {
          "path": "backend/app/api/palimpsest/hub.py",
          "must_contain": [
            "async def proxy_palimpsest_hub",
            "get_token_info",
            "_require_palimpsest_enabled",
            "f\"/v1/{path}\"",
            "return await proxy(\"palimpsest\", request, upstream_path)"
          ],
          "must_not_contain": [
            "@router.get(\"/layers\"",
            "@router.post(\"/uploads\"",
            "@router.post(\"/bundles/import\"",
            "from app.models.db import PalimpsestHub",
            "iter_bundle_tar",
            "parse_bundle"
          ]
        },
        {
          "path": "backend/app/services/service_proxy.py",
          "must_contain": [
            "async def proxy(",
            "getattr(request.state, \"token_info\", None)",
            "headers[\"x-auth-token\"] = token",
            "headers[\"x-project-id\"] = connection_project_id",
            "\"upload-offset\""
          ]
        }
      ],
      "counterparts": [
        {
          "path": "hub/src/palimpsest_hub/main.py",
          "must_contain": [
            "app.include_router(hub_router, prefix=\"/v1\""
          ]
        },
        {
          "path": "hub/src/palimpsest_hub/api/hub.py",
          "must_contain": [
            "operation_id=\"search_hub_layers\"",
            "operation_id=\"list_hub_images\"",
            "operation_id=\"download_hub_blob\"",
            "operation_id=\"start_upload\"",
            "operation_id=\"get_upload_status\"",
            "operation_id=\"append_upload\"",
            "operation_id=\"finalize_upload\"",
            "operation_id=\"abort_upload\"",
            "Depends(get_token_info)",
            "Depends(_legacy_writer)",
            "async def _owned_upload",
            "request.headers.get(\"Upload-Offset\")",
            "if upload.project_id != _required_project_id(token_info):",
            "upload.created_by != token_info.get(\"user_id\")",
            "\"Upload-Offset mismatch\""
          ]
        },
        {
          "path": "src/palimpsest_local/hub.py",
          "must_contain": [
            "HUB_API_PREFIX = \"/v1\"",
            "request_headers = {\"X-Auth-Token\": self._token}",
            "request_headers[\"X-Project-Id\"] = self._project_id",
            "headers={\"Upload-Offset\": str(offset)}",
            "with self._open(\"GET\", f\"/uploads/{session_id}\")"
          ]
        }
      ]
    },
    {
      "id": "layer-metadata-and-digest-v1",
      "status": "implemented",
      "analysis": "The extracted Hub owns Hub metadata, visibility, SQL persistence and blob identity. Afterglow retains its separate LayerArtifact lineage/admin APIs and digest helpers, but no Hub layer/upload/export models. The client owns canonical digests, verified references and local OCI interpretation. These structural boundaries do not establish SQL visibility or digest-verification behavior.",
      "upstream": [
        {
          "path": "backend/app/api/palimpsest/layers.py",
          "sha256": "2bb642bd94832df4f06c94bfe2042fa6842fa80a3e64d6b56c418ecde227f0fa"
        },
        {
          "path": "backend/app/models/db.py",
          "must_not_contain": [
            "class PalimpsestHubLayer",
            "class PalimpsestHubUpload",
            "class PalimpsestImageExport"
          ]
        },
        {
          "path": "backend/app/services/palimpsest_digest.py",
          "sha256": "5765291f50e42d58831afbb71e8017a53d4a11c39056f9b9b77f9b41b3b0a1f7"
        }
      ],
      "counterparts": [
        {
          "path": "hub/src/palimpsest_hub/models.py",
          "must_contain": [
            "class PalimpsestHubLayer(Base)",
            "class PalimpsestHubUpload(Base)",
            "class PalimpsestImageExport(Base)"
          ]
        },
        {
          "path": "hub/src/palimpsest_hub/services/digest.py",
          "must_contain": [
            "def normalize_digest",
            "def compute_config_digest",
            "def compute_chain_id"
          ]
        },
        {
          "path": "src/palimpsest_local/digest.py",
          "must_contain": [
            "def normalize_digest",
            "def require_file_digest"
          ]
        },
        {
          "path": "src/palimpsest_local/refs.py",
          "must_contain": [
            "class ImageRef:",
            "class LayerRef:",
            "class StackRef:"
          ]
        },
        {
          "path": "src/palimpsest_local/oci_layout.py",
          "must_contain": [
            "OCI_LAYOUT_VERSION",
            "def verify_layout_dir"
          ]
        }
      ]
    },
    {
      "id": "oci-bundle-v1",
      "status": "diverged-stricter-local",
      "analysis": "Palimpsest Hub owns OCI bundle export/import and complete parent-chain reconstruction; Afterglow only forwards /v1 requests. Both Hub and client verify received blob digests and descriptor bounds. Preserve the client's stricter local importer compatibility constraints; this ownership cutover does not weaken either importer or prove a real transfer/crash-durability result.",
      "upstream": [
        {
          "path": "backend/app/api/palimpsest/hub.py",
          "must_contain": [
            "async def proxy_palimpsest_hub",
            "f\"/v1/{path}\""
          ],
          "must_not_contain": [
            "iter_bundle_tar",
            "parse_bundle"
          ]
        }
      ],
      "counterparts": [
        {
          "path": "hub/src/palimpsest_hub/api/hub.py",
          "must_contain": [
            "operation_id=\"export_bundle\"",
            "operation_id=\"import_bundle\"",
            "if chain_rows[0].parent_digest is not None:",
            "if finalized.blob_digest != declared"
          ]
        },
        {
          "path": "hub/src/palimpsest_hub/services/hub_bundle.py",
          "must_contain": [
            "def iter_bundle_tar",
            "def parse_bundle",
            "\"parent_digest\": previous_digest"
          ]
        },
        {
          "path": "src/palimpsest_local/oci_layout.py",
          "must_contain": [
            "OCI_LAYOUT_VERSION",
            "def extract_bundle_tar",
            "def verify_layout_dir",
            "if len(members) > MAX_BUNDLE_MEMBERS:",
            "if index_data.get(\"mediaType\") != MEDIA_TYPE_INDEX:",
            "if actual_digest != expected_digest:"
          ]
        }
      ]
    },
    {
      "id": "local-runtime-cutover",
      "status": "partial",
      "analysis": "The standalone package owns local build, runtime, KVM, and CLI mechanics. Afterglow still owns its API registration, configuration, build orchestration, and administration. Changes here need an explicit cutover decision, not a source copy.",
      "upstream": [
        {
          "path": "backend/app/api/palimpsest/builds.py",
          "must_contain": [
            "@router.post(\"/dockerfile\", dependencies=[Depends(require_admin)])",
            "prepare_inline_dockerfile_import",
            "create_import_job"
          ]
        },
        {
          "path": "backend/app/api/palimpsest/admin.py",
          "sha256": "0e1c631ee017d7573b89c9a677cbbb7f4232f98d77418df8e98c2fbafe5d6445"
        },
        {
          "path": "backend/app/main.py",
          "must_contain": [
            "from app.api.palimpsest import",
            "app.include_router(palimpsest_hub_router, prefix=\"/api/v1/palimpsest/hub\"",
            "app.include_router(palimpsest_layers_router, prefix=\"/api/v1/palimpsest\"",
            "app.include_router(palimpsest_builds_router, prefix=\"/api/v1/palimpsest/builds\"",
            "app.include_router(palimpsest_admin_router, prefix=\"/api/v1/admin/palimpsest\""
          ]
        },
        {
          "path": "backend/app/config.py",
          "must_contain": [
            "service_palimpsest_enabled",
            "service_palimpsest_internal_url",
            "palimpsest_kvm_uri",
            "palimpsest_kvm_layer_root",
            "palimpsest_kvm_state_dir"
          ],
          "must_not_contain": [
            "palimpsest_hub_local_path",
            "palimpsest_hub_max_blob_bytes",
            "palimpsest_hub_upload_ttl_seconds"
          ]
        }
      ],
      "counterparts": [
        {
          "path": "src/palimpsest_local/cli.py",
          "must_contain": [
            "def main(",
            "from .build import build_layer",
            "runtime_dispatch.resolve_run_request"
          ]
        },
        {
          "path": "src/palimpsest_local/runtime.py",
          "must_contain": [
            "from .cloud_runtime import (",
            "\"run\"",
            "\"stop\"",
            "\"create_and_validate_overlay\""
          ]
        },
        {
          "path": "src/palimpsest_local/kvm.py",
          "must_contain": [
            "class DomainSpec:",
            "class OCIRootDomainSpec:",
            "def build_domain_xml",
            "def define_and_start"
          ]
        }
      ]
    },
    {
      "id": "union-layer-operations",
      "status": "afterglow-owned",
      "analysis": "Union layer operations coordinate Afterglow administration, NFS, Nova, and Manila. They have no standalone Palimpsest counterpart and must not be copied into this package.",
      "upstream": [
        {
          "path": "backend/app/api/union/layer_ops.py",
          "must_contain": [
            "@router.post(\"/build\", dependencies=[Depends(require_admin)])",
            "@router.post(\"/consume\", dependencies=[Depends(require_admin)])",
            "from app.services import manila"
          ]
        }
      ],
      "counterparts": []
    }
  ]
}

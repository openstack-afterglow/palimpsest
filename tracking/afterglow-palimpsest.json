{
  "schema_version": 1,
  "scope": "Palimpsest standalone package only; Lumen and Waygate are explicitly out of scope for this repository.",
  "upstream": {
    "repository": "https://github.com/openstack-afterglow/openstack-afterglow.git",
    "ref": "main",
    "baseline_commit": "d0250db689631f095dab2ac78ddad89651422c6b"
  },
  "absence_rules": [
    {
      "glob": "services/palimpsest*",
      "expected_matches": 0,
      "analysis": "A dedicated Palimpsest service does not exist at the baseline. Creation of one requires an explicit ownership and API review."
    }
  ],
  "contracts": [
    {
      "id": "hub-http-v1",
      "status": "implemented",
      "analysis": "The standalone Palimpsest Hub API and HubClient support native /v1 routes, Keystone token authentication, resumable uploads using Upload-Offset validation, and GET /v1/uploads/{session_id} status queries.",
      "upstream": [
        {
          "path": "backend/app/api/palimpsest/hub.py",
          "sha256": "51a31d6f5974743c823f825ac8b8fb9cabe4c332be6aabd37e0112b253ec5cc0",
          "must_contain": [
            "@router.get(\"/layers\")",
            "@router.get(\"/images\")",
            "@router.get(\"/layers/{digest}/blob\")",
            "@router.post(\"/uploads\")",
            "@router.patch(\"/uploads/{session_id}\")",
            "@router.put(\"/uploads/{session_id}\")",
            "@router.delete(\"/uploads/{session_id}\",",
            "@router.post(\"/bundles\")"
          ],
          "must_not_contain": [
            "@router.get(\"/uploads/{session_id}\")",
            "request.headers.get(\"upload-offset\")"
          ]
        }
      ],
      "counterparts": [
        {
          "path": "src/palimpsest_local/hub.py",
          "sha256": "424dcdd5c8295619db7b5bf995fb2bc7dd2f62944a3ccb4e366adefef44297a1",
          "must_contain": [
            "HUB_API_PREFIX = \"/v1\"",
            "f\"/uploads/{session_id}\"",
            "headers={\"Upload-Offset\": str(offset)}",
            "with self._open(\"GET\", f\"/uploads/{session_id}\")"
          ]
        }
      ]
    },
    {

          "must_contain": [
            "def normalize_digest"
          ]
        },
        {
          "path": "src/palimpsest_local/refs.py",
          "sha256": "fba9ecd94e3185860ff81f462e0e8190ec7e13c83bba553809d9ed211f5d1b60"

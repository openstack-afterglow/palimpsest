!README.md
!pyproject.toml
!src/**
!hub/pyproject.toml
!hub/uv.lock
!hub/src/**
!deploy/kolla/ansible/palimpsest-build-worker.yml
!deploy/kolla/ansible/roles/palimpsest/**

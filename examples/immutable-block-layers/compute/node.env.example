# /etc/blkstack/node.env on every compute node. No secrets here: the Ceph identity and its
# keyring are selected with the usual rbd arguments.
BLKSTACK_ROOT=/var/lib/blkstack
BLKSTACK_LAYER_POOL=lib-layers
# With Cinder this is the backend's rbd_pool (for example `volumes`); the proof scripts use user-delta.
BLKSTACK_DELTA_POOL=user-delta
BLKSTACK_RBD="rbd --id blkstack-node"
